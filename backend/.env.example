DATABASE_URL="postgresql://usuario:password@localhost:5432/sicat?schema=public"
NODE_ENV=development
JWT_SECRET="cambia_esto_por_un_secreto_de_32_caracteres_o_mas"
PORT=3000

FRONTEND_URL=http://localhost:5173

# Mantener desactivado mientras SICAT use número de control o username.
# Para habilitar verificación, registro público y recuperación por correo,
# cambia este valor a true y configura todas las variables MAIL_*.
AUTH_EMAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=usuario_smtp
MAIL_PASSWORD=password_smtp
MAIL_FROM="SICAT <no-reply@example.com>"

# Lectura automática de fotografías de horarios. La imagen no se conserva
# después de que un administrador aprueba o rechaza la importación.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-sol
